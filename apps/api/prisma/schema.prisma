// Mô hình MySQL của tài khoản, catalog, giỏ hàng và đơn hàng theo M1-05.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// Giá trị role/status được MySQL kiểm tra trong migration M3-01.
model User {
  id                 BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  email              String              @unique @db.VarChar(254)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  role               String              @db.VarChar(24)
  status             String              @db.VarChar(24)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  addresses          Address[]
  sessions           Session[]
  cart               Cart?
  orders             Order[]
  reviews            Review[]
  adminAudits        AdminAuditLog[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

model Session {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  lastSeenAt DateTime  @map("last_seen_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

model Address {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt  @map("user_id") @db.UnsignedBigInt
  name        String  @db.VarChar(191)
  phone       String  @db.VarChar(32)
  addressText String  @map("address_text") @db.Text
  isDefault   Boolean @default(false) @map("is_default")
  user        User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("addresses")
}

model Category {
  id       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name     String    @db.VarChar(191)
  slug     String    @unique @db.VarChar(191)
  status   String    @db.VarChar(24)
  products Product[]

  @@map("categories")
}

model Product {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId  BigInt           @map("category_id") @db.UnsignedBigInt
  name        String           @db.VarChar(191)
  slug        String           @unique @db.VarChar(191)
  description String           @db.Text
  status      String           @db.VarChar(24)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  images      ProductImage[]
  reviews     Review[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id            BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  productId     BigInt              @map("product_id") @db.UnsignedBigInt
  sku           String              @unique @db.VarChar(128)
  size          String              @db.VarChar(48)
  color         String              @db.VarChar(80)
  price         Decimal             @db.Decimal(12, 2)
  stockQuantity Int                 @default(0) @map("stock_quantity")
  status        String              @db.VarChar(24)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements     InventoryMovement[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id         BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  productId  BigInt  @map("product_id") @db.UnsignedBigInt
  storageKey String  @map("storage_key") @db.VarChar(255)
  altText    String? @map("alt_text") @db.VarChar(255)
  sortOrder  Int     @default(0) @map("sort_order")
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("product_images")
}

model Cart {
  id        BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt     @unique @map("user_id") @db.UnsignedBigInt
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  cartId    BigInt         @map("cart_id") @db.UnsignedBigInt
  variantId BigInt         @map("variant_id") @db.UnsignedBigInt
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                 BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  userId             BigInt              @map("user_id") @db.UnsignedBigInt
  status             String              @db.VarChar(24)
  subtotal           Decimal             @db.Decimal(12, 2)
  shippingFee        Decimal             @map("shipping_fee") @db.Decimal(12, 2)
  total              Decimal             @db.Decimal(12, 2)
  addressSnapshot    Json                @map("address_snapshot")
  idempotencyKey     String              @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String              @map("request_fingerprint") @db.Char(64)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  inventoryMovements InventoryMovement[]
  payment            PaymentRecord?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@map("orders")
}

model OrderItem {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  orderId       BigInt         @map("order_id") @db.UnsignedBigInt
  variantId     BigInt         @map("variant_id") @db.UnsignedBigInt
  skuSnapshot   String         @map("sku_snapshot") @db.VarChar(128)
  nameSnapshot  String         @map("name_snapshot") @db.VarChar(191)
  sizeSnapshot  String         @map("size_snapshot") @db.VarChar(48)
  colorSnapshot String         @map("color_snapshot") @db.VarChar(80)
  unitPrice     Decimal        @map("unit_price") @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal        @map("line_total") @db.Decimal(12, 2)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  review        Review?

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Review {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  productId   BigInt    @map("product_id") @db.UnsignedBigInt
  orderItemId BigInt    @unique @map("order_item_id") @db.UnsignedBigInt
  rating      Int       @db.UnsignedTinyInt
  content     String    @db.Text
  status      String    @default("VISIBLE") @db.VarChar(24)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([productId, status, createdAt])
  @@map("reviews")
}

model PaymentRecord {
  id                BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  orderId           BigInt  @unique @map("order_id") @db.UnsignedBigInt
  method            String  @db.VarChar(24)
  status            String  @db.VarChar(24)
  providerReference String? @unique @map("provider_reference") @db.VarChar(191)
  idempotencyKey    String  @map("idempotency_key") @db.VarChar(128)
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("payment_records")
}

model AdminAuditLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actorUserId BigInt   @map("actor_user_id") @db.UnsignedBigInt
  action      String   @db.VarChar(64)
  targetType  String   @map("target_type") @db.VarChar(48)
  targetId    BigInt   @map("target_id") @db.UnsignedBigInt
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@map("admin_audit_logs")
}

model InventoryMovement {
  id          BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  variantId   BigInt         @map("variant_id") @db.UnsignedBigInt
  orderId     BigInt?        @map("order_id") @db.UnsignedBigInt
  actorUserId BigInt         @map("actor_user_id") @db.UnsignedBigInt
  delta       Int
  reason      String         @db.Text
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor       User           @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt, id])
  @@index([actorUserId])
  @@index([orderId])
  @@map("inventory_movements")
}
