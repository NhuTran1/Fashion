# Cấu hình Docker Compose và API cho môi trường local.
# Sao chép thành .env và đặt hai mật khẩu riêng.
APP_HOST=127.0.0.1
APP_PORT=3000
# Auth dùng URL MySQL và một Origin Web tin cậy. Điền giá trị trong .env local.
DATABASE_URL=
AUTH_WEB_ORIGIN=http://127.0.0.1:3000
PRODUCT_IMAGE_DIR=storage/local/product-images
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=fashioncommerce_dev
DB_USER=fashioncommerce_dev
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
